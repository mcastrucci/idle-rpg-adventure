          "value": "(\"rpg_expeditions\".\"status\" = 'running' AND \"rpg_expeditions\".\"settled_at\" IS NULL AND \"rpg_expeditions\".\"settled_reason\" IS NULL AND \"rpg_expeditions\".\"settled_cutoff\" IS NULL AND \"rpg_expeditions\".\"outcome\" IS NULL) OR (\"rpg_expeditions\".\"status\" = 'cancelled' AND \"rpg_expeditions\".\"settled_at\" IS NOT NULL AND \"rpg_expeditions\".\"settled_reason\" = 'cancelled' AND \"rpg_expeditions\".\"settled_cutoff\" IS NOT NULL AND \"rpg_expeditions\".\"outcome\" IS NULL) OR (\"rpg_expeditions\".\"status\" = 'completed' AND \"rpg_expeditions\".\"settled_at\" IS NOT NULL AND \"rpg_expeditions\".\"settled_reason\" = 'completed' AND \"rpg_expeditions\".\"settled_cutoff\" IS NOT NULL AND \"rpg_expeditions\".\"outcome\" IS NOT NULL)"
        }
