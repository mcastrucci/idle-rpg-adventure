{
  "name": "idle-rpg-adventure",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "lint:boundaries:test": "vitest run --project boundaries",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm content:validate",
    "content-cli": "node engine/content-compiler/src/bin.ts",
    "balance-sim": "node games/rpg/tools/balance-sim/src/bin.ts",
    "content:validate": "pnpm content-cli validate games/rpg/content --game ./games/rpg/tools/content-plugin/src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
